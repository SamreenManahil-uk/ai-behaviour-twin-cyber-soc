# Copy to .env (Git-ignored), then replace both fake passwords with generated values.
# The admin role initializes PostgreSQL; the API uses only the app role.
POSTGRES_ADMIN_USER=cyber_soc_admin
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
POSTGRES_APP_USER=cyber_soc_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_GENERATED_APP_PASSWORD

POSTGRES_HOST_PORT=5433

# Local application ports
BACKEND_HOST_PORT=5080
ML_HOST_PORT=8001
FRONTEND_HOST_PORT=5173
JWT_ISSUER=CyberSoc.Api.Local
JWT_AUDIENCE=CyberSoc.Frontend.Local
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=30
