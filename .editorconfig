root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csx,py,pyi}]
indent_size = 4

[*.{csproj,fsproj,vbproj,props,targets,xml,config}]
indent_size = 2

[*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,yml,yaml,html,css,scss}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
